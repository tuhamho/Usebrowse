{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuhamho Brow",
  "mainBinaryName": "tuhamho-brow",
  "version": "../../daemon/package.json",
  "identifier": "com.tuhamho.brow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn win:payload && yarn win:ui:dev",
    "beforeBuildCommand": "yarn win:payload && yarn win:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tuhamho Brow",
        "width": 1040,
        "height": 760,
        "minWidth": 940,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#110A06"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "tuhamho",
    "homepage": "https://github.com/tuhamho/Usebrowse",
    "copyright": "Copyright © 2026 tuhamho. Apache License 2.0.",
    "category": "DeveloperTool",
    "shortDescription": "Your browser, driven by the AI agent you already run",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "resources/payload/": "payload/",
      "resources/launcher/": "launcher/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["browsentic"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1RDA4NDRDOTc2QTg5RTcKUldUbmlXcVhUSVRRUlJiQ2hPNVNuWWNSMXc2NjZSai9VeU16WnAyQmdLZU5odkZiSmF2UHhmVlEK",
      "endpoints": ["https://github.com/tuhamho/Usebrowse/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
